diff --git a/CMakeLists.txt b/CMakeLists.txt
index 41980b3..99d3996 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,19 @@ find_package(std_msgs REQUIRED)
 find_package(builtin_interfaces REQUIRED)
 find_package(rosidl_default_generators REQUIRED)
 
+# Keep the SDK's bundled spdlog private; ROS links a different spdlog ABI.
+include(FetchContent)
+FetchContent_Declare(livox_sdk
+  GIT_REPOSITORY https://github.com/Livox-SDK/Livox-SDK2.git
+  GIT_TAG 6a940156dd7151c3ab6a52442d86bc83613bd11b)
+FetchContent_GetProperties(livox_sdk)
+if(NOT livox_sdk_POPULATED)
+  FetchContent_Populate(livox_sdk)
+  add_subdirectory(${livox_sdk_SOURCE_DIR}/sdk_core ${livox_sdk_BINARY_DIR} EXCLUDE_FROM_ALL)
+endif()
+set_target_properties(livox_lidar_sdk_static PROPERTIES
+  POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
+
 # check apr
 find_package(PkgConfig)
 
@@ -96,22 +109,16 @@ target_include_directories(${PROJECT_NAME} PUBLIC
   ${PCL_INCLUDE_DIRS}
   ${APR_INCLUDE_DIRS}
   ${LIVOX_INTERFACES_INCLUDE_DIRECTORIES}   # for custom msgs
-  Livox-SDK2/include
+  ${livox_sdk_SOURCE_DIR}/include
   3rdparty
   src
 )
 
-if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64")
-  set(LIVOX_LIDAR_SDK_LIBRARY ${PROJECT_SOURCE_DIR}/Livox-SDK2/lib/amd64/liblivox_lidar_sdk_shared.so)
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64")
-set(LIVOX_LIDAR_SDK_LIBRARY ${PROJECT_SOURCE_DIR}/Livox-SDK2/lib/arm64/liblivox_lidar_sdk_shared.so)
-else()
-  message(FATAL_ERROR "Unsupport host system architecture: ${CMAKE_HOST_SYSTEM_PROCESSOR}!")
-endif()
+target_link_options(${PROJECT_NAME} PRIVATE "-Wl,--exclude-libs,liblivox_lidar_sdk_static.a")
 
 # link libraries
 target_link_libraries(${PROJECT_NAME}
-  ${LIVOX_LIDAR_SDK_LIBRARY}
+  livox_lidar_sdk_static
   ${LIVOX_INTERFACE_TARGET}   # for custom msgs
   ${PPT_LIBRARY}
   ${Boost_LIBRARY}
