+Rmua19RobotBaseNode::~Rmua19RobotBaseNode()
+{
+  // Transport callbacks capture controller pointers through the data sensors.
+  // Stop them before controllers/publishers are destroyed in reverse order.
+  gz_gimbal_encoder_->stop();
+  gz_gimbal_imu_->stop();
+  if (gz_chassis_odometry_) {
+    gz_chassis_odometry_->stop();
+  }
+}
