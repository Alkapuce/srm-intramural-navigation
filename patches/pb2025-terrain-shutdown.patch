+void SensorScanGenerationNode::odometryHandler(
+  const nav_msgs::msg::Odometry::ConstSharedPtr & odometry_msg)
+{
+  tf2::Transform tf_odom_to_lidar;
+  tf2::fromMsg(odometry_msg->pose.pose, tf_odom_to_lidar);
+  try {
+    const auto stamp = odometry_msg->header.stamp;
+    const auto chassis = tf_odom_to_lidar * getTransform(lidar_frame_, base_frame_, stamp);
+    const auto robot = tf_odom_to_lidar * getTransform(lidar_frame_, robot_base_frame_, stamp);
+    // Navigation pose follows source odometry; a delayed cloud must not delay TF.
+    publishTransform(chassis, odometry_msg->header.frame_id, base_frame_, stamp);
+    publishOdometry(robot, odometry_msg->header.frame_id, robot_base_frame_, stamp);
+  } catch (const tf2::TransformException & ex) {
+    RCLCPP_WARN_THROTTLE(
+      this->get_logger(), *this->get_clock(), 2000,
+      "Frame transform unavailable; odometry withheld: %s", ex.what());
+  }
+}
