#!/usr/bin/env bash
set -euo pipefail
entry="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(dirname -- "$(dirname -- "$entry")")"
command="${1:-help}"
[[ $# == 0 ]] || shift
usage() {
  cat <<'HELP'
SRM 导航调试（在执行本命令的机器上运行，不自动 SSH）
  srm-nav status                     主机、设备和相关进程，只读
  srm-nav topics                     本项目 ROS 话题列表，只读
  srm-nav hz TOPIC                    话题频率，Ctrl-C 结束
  srm-nav tf [PARENT CHILD]           默认 map → base_footprint，Ctrl-C 结束
  srm-nav sensors [CONFIG_DIR]        启动雷达/Point-LIO，不打开底盘串口
  srm-nav standby [MAP_DIR]           启动最新地图的导航待机，运动和任务启动锁定
  srm-nav field [MAP_DIR] [--parking-here|--parking X Y] [--profile safe|candidate] [--response-model FILE] [--output cache/DIR]
                    从本次地图识别两桩，联合优化完整路线和速度；--parking-here 自动记录当前发车位
  srm-nav localize [MAP_DIR]          静止采样匹配旧图，更新下次导航的定位初值，不发车
  srm-nav drive [MAP_DIR] [DEVICE]    启用最新已确认场地的导航与串口，任务仍需手动 start
  srm-nav check-standby [MAP_DIR]     检查已启动的地图待机，不打开串口
  srm-nav start                      发车并持续显示进度，结束打印摘要；Ctrl-C 取消
  srm-nav cancel|reset               取消或复位任务
  srm-nav start-here                 从当前位置规划接入完整八字，最终回原停车位
  srm-nav return-home TRACE MAP_DIR   按记录轨迹倒序低速回位；替代 drive，仍需另执行 start
  srm-nav mission-status              查看一次任务就绪状态
  srm-nav result [RUN_DIR]            查看最新一轮或指定运行目录的详细结果
  srm-nav standby-down               正常关闭待机生命周期，然后在启动终端 Ctrl-C
  srm-nav bag-info [BAG_DIR]          查看最新已收尾的 bag
  srm-nav bag-check [BAG_DIR]         校验最新已收尾的 bag，保存新报告
  srm-nav map-check [MAP_DIR]         检查最新地图的栅格通行空间，保存新报告
  srm-nav preview [DIR] [--output PNG] [--all]
                    导出地图/路线 PNG 到 artifacts/.png/；--all 导出全部已建地图
  srm-nav zero [DEVICE]              打开指定或唯一匹配串口，只发零速 8 秒
  srm-nav map [ARGS...]               转到 srm-map
  srm-nav pulse [ARGS...]             转到 srm-pulse
  srm-nav ros ROS2_ARGS...            在项目环境执行原生 ros2 命令
  srm-nav help                       显示本帮助
省略路径会选择最新有效产物并打印目录；显式路径支持当前目录或项目内的相对路径。
drive 仅自动选择有 field_geometry_verified 的导航配置，不从归档/测试目录选择。
校验报告位于项目 artifacts/diagnostics/。没有全局 kill/自动重启命令。
HELP
}
one_arg() { [[ $# == 1 ]] || { usage >&2; exit 2; }; }
optional_arg() { [[ $# -le 1 ]] || { usage >&2; exit 2; }; }
runtime_path() {
  local absolute input="$1"
  if [[ "$input" != /* && ! -e "$input" && -e "$root/$input" ]]; then input="$root/$input"; fi
  absolute="$(realpath -e -- "$input")" || return 1
  case "$absolute" in
    "$root"/*) echo "/work/${absolute#"$root"/}" ;;
    *) echo "$absolute" ;;
  esac
}
select_path() {
  local kind="$1" input="${2:-}"
  if [[ -z "$input" ]]; then input="$(python3 "$root/scripts/internal/field_paths.py" "$kind")" || return; fi
  echo "使用 $kind: $input" >&2
  runtime_path "$input"
}
serial_device() {
  local input="${1:-${INTRAMURAL_SERIAL_DEVICE:-}}"
  if [[ -z "$input" ]]; then
    shopt -s nullglob
    local candidates=(/dev/serial/by-id/usb-1a86_USB_Single_Serial_*-if00)
    [[ ${#candidates[@]} == 1 ]] || { echo '串口不唯一或不存在，请指定 DEVICE' >&2; return 2; }
    input="${candidates[0]}"
  fi
  realpath -e -- "$input"
}
report_dir() {
  report="$root/artifacts/diagnostics/$command-$(date +%Y%m%d-%H%M%S-%N)"
  mkdir -p "$report"
  echo "报告目录: $report"
}
case "$command" in
  help|-h|--help) usage ;;
  status)
    hostname
    printf 'boot_id: '; cat /proc/sys/kernel/random/boot_id
    ip -br -4 address
    ls -l /dev/serial/by-id/ 2>/dev/null || true
    ps -eo user,pid,comm,args | awk 'NR == 1 || /[l]ivox|[p]ointlio|[s]erial_bridge|[v]ehicle-pulse|[r]m_behavior_tree|[s]tandard_robot_pp|[r]m_nav_bringup|[r]os2 bag|[s]ite-mapping.py/'
    ss -lun | awk 'NR == 1 || /:56[0-4]0[01][[:space:]]/'
    echo '进程/端口列表不能证明串口全机独占；普通用户无法检查其他用户的全部文件描述符。'
    ;;
  topics) exec "$root/scripts/run.sh" ros2 topic list --no-daemon ;;
  hz) one_arg "$@"; exec "$root/scripts/run.sh" ros2 topic hz "$1" ;;
  tf)
    [[ $# == 0 || $# == 2 ]] || { usage >&2; exit 2; }
    exec "$root/scripts/run.sh" ros2 run tf2_ros tf2_echo "${1:-map}" "${2:-base_footprint}" ;;
  sensors)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    config="$(runtime_path "${1:-${INTRAMURAL_VEHICLE_CONFIG:-$root/cache/vehicle-current}}")"
    export INTRAMURAL_VEHICLE_CONFIG="$config"
    exec "$root/scripts/vehicle-sensors.sh" ;;
  standby)
    optional_arg "$@"
    config="$(select_path map "${1:-${INTRAMURAL_NAVIGATION_CONFIG:-}}")"
    export INTRAMURAL_NAVIGATION_CONFIG="$config"
    exec "$root/scripts/vehicle-navigation.sh" ;;
  field)
    input=
    if [[ $# -gt 0 && "$1" != --* ]]; then input="$1"; shift; fi
    input="$(select_path map "$input")"
    exec "$root/scripts/run.sh" python3 /work/scripts/internal/field_geometry.py --map-config "$input" "$@" ;;
  preview) exec python3 "$root/scripts/internal/field_preview.py" "$@" ;;
  localize)
    optional_arg "$@"; input="$(select_path navigation "${1:-${INTRAMURAL_NAVIGATION_CONFIG:-}}")"
    mkdir -p "$root/cache/runtime"
    exec 9>"$root/cache/runtime/vehicle-navigation.lock"
    flock -n 9 || { echo '先退出当前导航，再重新定位；传感器保持运行。' >&2; exit 75; }
    exec "$root/scripts/run.sh" python3 /work/scripts/internal/relocalize.py --map-config "$input" ;;
  return-home)
    [[ $# == 2 ]] || { usage >&2; exit 2; }
    trace="$(runtime_path "$1")"; config="$(runtime_path "$2")"
    output="$root/cache/recovery-$(date +%Y%m%d-%H%M%S-%N)"
    "$root/scripts/run.sh" python3 /work/scripts/internal/prepare-return.py --trace "$trace" --navigation-config "$config" --output "/work/cache/${output##*/}"
    exec "$root/scripts/srm-nav" drive "$output" ;;
  drive)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    config="$(select_path navigation "${1:-${INTRAMURAL_NAVIGATION_CONFIG:-}}")"
    device="$(serial_device "${2:-}")"
    export INTRAMURAL_NAVIGATION_CONFIG="$config"
    exec "$root/scripts/vehicle-navigation.sh" "enable_motion:=true" "serial_device:=$device" ;;
  check-standby)
    optional_arg "$@"; input="$(select_path map "${1:-${INTRAMURAL_NAVIGATION_CONFIG:-}}")"; report_dir
    exec "$root/scripts/run.sh" python3 /work/scripts/validation/verify-vehicle-standby.py --map-config "$input" --output "$(runtime_path "$report")" ;;
  start|start-here)
    [[ $# == 0 ]] || { usage >&2; exit 2; }
    exec "$root/scripts/run.sh" python3 /work/scripts/internal/mission_console.py "$command" ;;
  result)
    optional_arg "$@"
    exec python3 "$root/scripts/internal/mission_console.py" result "$@" ;;
  cancel|reset)
    [[ $# == 0 ]] || { usage >&2; exit 2; }
    exec "$root/scripts/run.sh" ros2 service call "/intramural_robot/mission/${command//-/_}" std_srvs/srv/Trigger '{}' ;;
  mission-status)
    exec "$root/scripts/run.sh" ros2 topic echo --once --full-length /intramural_robot/mission/status ;;
  standby-down)
    exec "$root/scripts/run.sh" ros2 service call /intramural_robot/lifecycle_manager_vehicle/manage_nodes nav2_msgs/srv/ManageLifecycleNodes '{command: 4}' ;;
  bag-info)
    optional_arg "$@"; input="$(select_path bag "${1:-}")"
    exec "$root/scripts/run.sh" ros2 bag info "$input" ;;
  bag-check|map-check)
    optional_arg "$@"; kind="${command%-check}"; input="$(select_path "$kind" "${1:-}")"; report_dir
    if [[ "$command" == bag-check ]]; then
      exec "$root/scripts/run.sh" python3 /work/scripts/validation/verify-mapping-bag.py --bag "$input" --output "$(runtime_path "$report")/result.json"
    fi
    exec "$root/scripts/run.sh" python3 /work/scripts/validation/verify-map-quality.py --map-config "$input" --output "$(runtime_path "$report")/result.json" ;;
  zero)
    optional_arg "$@"; input="$(serial_device "${1:-}")"; report_dir
    exec "$root/scripts/run.sh" python3 /work/scripts/validation/verify-serial-zero.py --device "$input" --output "$(runtime_path "$report")/result" ;;
  map) exec "$root/scripts/srm-map" "$@" ;;
  pulse) exec "$root/scripts/srm-pulse" "$@" ;;
  ros) [[ $# -gt 0 ]] || { usage >&2; exit 2; }; exec "$root/scripts/run.sh" ros2 "$@" ;;
  *) usage >&2; exit 2 ;;
esac
